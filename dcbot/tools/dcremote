def command_of(pid):
    """The command line of a process ("" if it is gone): /proc on Linux, ps on macOS."""
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            return f.read().decode("utf-8", "replace")
    except OSError:
        pass
    r = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                       universal_newlines=True)
    return r.stdout


OLD = 75  # C-163: a request of a bot older (a smaller epoch) than one this machine has seen: refused
NOT_THE_BOTS = ("tmux-list", "tmux-read", "tmux-send", "tmux-at", "claude-at", "owner-clear", "-h", "--help")  # what the altention
# command line asks of this machine (the owner's, a Claude's), never a bot: no epoch to send, never refused for it


def owner_path():
    return os.path.join(os.path.expanduser("~"), ".local", "share", "altention", "dcremote-owner")


def owner():
    """The biggest epoch of a bot this machine has seen (C-163 section 1.4: fencing); 0 when none."""
    try:
        with open(owner_path()) as f:
            return int(f.read().strip() or 0)
    except (OSError, ValueError):
        return 0


def fenced(epoch):
    """`epoch` (a request's, None when it has none: a bot without a standby) against the biggest seen: True when it
    is older (refused); a newer one is written down. Without an epoch: refused once this machine has seen a bot with
    a standby (its owner file above 0: a bot that left the epoch out, before its first lease round, is no newer one;
    #code-review on abc07b3, manager); on a machine that never has, nothing is checked or written."""
    if epoch is None:
        return owner() > 0
    seen = owner()
    if epoch < seen:
        return True
    if epoch > seen:
        os.makedirs(os.path.dirname(owner_path()), exist_ok=True)
        tmp = "%s.%d" % (owner_path(), os.getpid())
        with open(tmp, "w") as f:
            f.write(str(epoch))
        os.replace(tmp, owner_path())
    return False


def bot_host(machine, epoch):
    """C-163 section 4.4: the bot runs on `machine` since epoch `epoch` (written by that bot); an older epoch does
    not overwrite a newer one."""
    from altention import config as engine_config
    if not engine_config.write_bot_host(machine, epoch):
        print(json.dumps({"error": "epoch %s is older than the one written" % epoch, "code": OLD}))
        sys.exit(OLD)


def stream(epoch=None, bot_spool=False):
    """Events as they come, one JSON line each. A transcript is read here, where it is, so the bot gets what
    Claude said along with the event (the bot's machine cannot read this machine's files). With an epoch (C-163):
    a stream of an older bot is not started and stops another nothing; one running stops once a newer bot's
    epoch is seen (the old bot reads no events after a takeover). `bot_spool`: the stream the bot that took over
    keeps to the old bot machine's own spool (section 1.4: its windows' hooks write there), under its own pid file."""
    if fenced(epoch):
        print(json.dumps({"error": "an older bot (epoch %s; this machine has seen %s)" % (epoch, owner()), "code": OLD}))
        sys.exit(OLD)
    pidfile = os.path.join(STATE, "stream.pid")  # (one for both kinds: they read the same spool, and two at once
    # would each send what the other sends: #code-review-2 on 94f58e5)
    try:  # a stream left over from a bot that has gone would take the events: stop it
        with open(pidfile) as f:
            old = int(f.read().strip() or 0)
        if old and old != os.getpid() and "dcremote" in command_of(old):
            os.kill(old, 15)
    except (OSError, ValueError):
        pass
    os.makedirs(STATE, exist_ok=True)
    with open(pidfile, "w") as f:
        f.write(str(os.getpid()))
    sys.stdout.write('{"heartbeat": 1}\n')  # at once: the bot knows the line is up (code-review 2026-10-07)
    sys.stdout.flush()
    pos, last = {}, time.time()
    while True:
        if epoch is not None and owner() > epoch:  # a newer bot took over: this old one reads no more
            sys.exit(OLD)
        if relay(SPOOL, pos, sys.stdout):
            last = time.time()
        if time.time() - last > 20:  # tells the bot the line is alive
            sys.stdout.write('{"heartbeat": 1}\n')
            sys.stdout.flush()
            last = time.time()
        time.sleep(0.1 if getattr(relay, "held", False) else 0.3)  # an event waits for its row (awaits()): look again soon


def relay(spool, pos, out):
    """One pass over the spool: each event goes out as a JSON line (with what Claude said since the last one,
    read here where the transcript is), and only then is its spool file removed. Returns how many went out.
    `pos`: how far each transcript has been read. The spool file and the transcript are different paths:
    never mix them up (the transcript is the conversation itself)."""
    sent, held = 0, set()
    for spooled, ev in events.waiting(spool):
        key = ev.get("transcript_path") or ev.get("channel")
        cc_hooks.normalize(ev)  # what kind of thing it is: from the event alone, before the wait is decided
        try:
            wait = key in held or cc_hooks.awaits(ev, pos)
        except Exception:
            wait = False  # whatever went wrong looking: the event goes
        if wait:  # a tool call, or a turn's end, whose own row is not written yet (for at most cc_hooks.HOLD_SECS,
            # END_HOLD_SECS): left in the spool
            held.add(key)  # with every later event of its conversation behind it; the other conversations' go on.
            continue       # Not slept for: that would hold every channel of this machine back
        try:
            enrich(ev, pos)
        except Exception as e:  # what Claude said is extra: the event itself still goes
            ev["relay_error"] = "%s: %s" % (type(e).__name__, e)
        try:
            out.write(json.dumps(ev, ensure_ascii=False) + "\n")
            out.flush()
        except (TypeError, ValueError, UnicodeError):
            events.set_aside(spooled, spool)  # cannot be sent at all: out of the way, kept for a look
            continue
        events.done(spooled)  # the spool file, only once its event is on its way to the bot
        sent += 1
    relay.held = bool(held)  # something was left for the next pass: stream() comes back sooner
    return sent


ADDED = cc_hooks.ADDED + cc_hooks.NORMALIZED + ("relay_error",)  # what the connector's enrich() and relay() add to an event (the bot's
# stream() adds "host"). tests/test_hook_fields.py holds them against real payloads.
def enrich(ev, pos):
    """What only this machine can read is added to an event (the connector's enrich()); and for a subagent that has
    just started, what it was started as: its files are written a moment after the event, and are waited for here,
    asleep (the connector's agent_waits(): up to 1.5 s)."""
    cc_hooks.enrich(ev, pos)
    if ev.get("hook_event_name") == "SubagentStart" and ev.get("agent_id"):
        for gap in cc_hooks.agent_waits(ev):
            time.sleep(gap)



def tmux_ref(text):
    """The identifier parsed, or exit 2 saying why (bad identifier)."""
    try:
        return tmuxref.parse(text)
    except tmuxref.BadId as e:
        print(json.dumps({"error": str(e), "code": 2}, ensure_ascii=False))
        sys.exit(2)


def tmux_read(text, lines):
    ref = tmux_ref(text)
    try:
        lines = int(lines)
    except ValueError:
        print(json.dumps({"error": "行數要是數字：%s" % lines, "code": 2}, ensure_ascii=False))
        sys.exit(2)
    out = tmuxref.read(ref, lines)
    print(json.dumps(out, ensure_ascii=False))
    if "error" in out:
        sys.exit(out.get("code", 3))


def tmux_at(text):
    ref = tmux_ref(text)
    path, now = tmuxref.at(ref)
    if now is None or (ref.get("pane_id") and ref["pane_id"] != now):
        print(json.dumps({"error": "那個位置沒有窗格" if now is None else "那個位置現在是窗格 %s，不是 %s：請重新 list" % (now, ref["pane_id"]),
                          "code": 3}, ensure_ascii=False))
        sys.exit(3)
    print(json.dumps({"socket": path, "pane": now}))


def audit_here(line):
    """A line in the bot's #audit from this machine (altention dc post @audit --wait 30): whether it got there, True;
    None when that is not known (no answer in time: still queued, exit 3, or the post did not end), False when not."""
    try:
        r = subprocess.run([sys.executable, os.path.join(os.path.dirname(ROOT), "bin", "altention"), "dc", "post",
                            "@audit", "--wait", "30", line], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.PIPE, universal_newlines=True, timeout=60)
    except subprocess.TimeoutExpired:
        return None
    except OSError:
        return False
    return True if r.returncode == 0 else None if r.returncode == 3 else False


def audit_nowait(line):
    """A line for #audit, posted in the background: this command does not wait for it (nor for its end)."""
    try:
        subprocess.Popen([sys.executable, os.path.join(os.path.dirname(ROOT), "bin", "altention"), "dc", "post", "@audit", line],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def tmux_send(text):
    """C-92 b-1: type into the pane the ID names (bot/tmuxsend.py), what to type as JSON on stdin: {"text" or
    "keys", "enter", "caller", "reason"}. Prints {"sent", "pane"} or {"error", "code"}, exits with the code."""
    from bot import tmuxsend
    from altention.connectors.claude_code import process, screen, typist
    ref = tmux_ref(text)
    try:
        asked = json.loads(sys.stdin.read() or "{}")
        if not isinstance(asked, dict):
            raise ValueError
    except ValueError:
        print(json.dumps({"error": "stdin 要是 JSON 物件", "code": 2}, ensure_ascii=False))
        sys.exit(2)
    out = tmuxsend.send(ref, text, asked.get("text"), asked.get("keys") or [], bool(asked.get("enter")),
                        str(asked.get("caller") or ""), str(asked.get("reason") or ""), audit=audit_here, audit_later=audit_nowait,
                        is_claude=lambda c, pid: process.Lazy()(c, pid),  # read anew at each look
                        pane_state=screen.pane_state, pace=(typist.TYPE_CHUNK, typist.TYPE_PAUSE),
                        box_text=tmuxsend.box_check(screen))
    print(json.dumps(out, ensure_ascii=False))
    if "error" in out:
        sys.exit(out["code"])



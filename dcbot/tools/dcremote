def claude_here():
    """This machine's Claude Code by its full path (a window the bot opens here runs it by that, not by a PATH a
    non-interactive ssh may not have: drill 11-08, the low the manager ruled); None when there is none."""
    import shutil
    extra = [os.path.expanduser("~/.local/bin"), "/opt/homebrew/bin", "/usr/local/bin"]
    return shutil.which("claude", path=os.pathsep.join([os.environ.get("PATH", "")] + extra))


SPOOL_NAME = re.compile(r"^\d{20}-\d+\.json$")  # bot/postbox.py write()'s names (the time first: oldest first)


def spool_dir():
    return os.path.join(STATE, "posts")  # (state/posts only: these three touch nothing else)


def spool_out():
    """C-188: [{name, post}] of the posts waiting in this machine's spool (state/posts), oldest first, left in place
    (spool_drop() once the bot elsewhere has them). A file not readable as JSON is left out and left alone."""
    out = []
    try:
        names = sorted(n for n in os.listdir(spool_dir()) if SPOOL_NAME.match(n))
    except OSError:
        return out
    for name in names:
        try:
            with open(os.path.join(spool_dir(), name)) as f:
                post = json.load(f)
        except (OSError, ValueError):
            continue
        if isinstance(post, dict):
            out.append({"name": name, "post": post})
    return out


def spool_drop(names):
    """C-188: the posts of those names taken away from state/posts (only names of the spool's own shape)."""
    gone = 0
    for name in names:
        if SPOOL_NAME.match(name):
            try:
                os.remove(os.path.join(spool_dir(), name))
                gone += 1
            except FileNotFoundError:
                pass
    return gone


def spool_in(items):
    """C-188: posts from the bot elsewhere written into state/posts under their own names (whole files: a temporary
    name, then renamed), so that their order among this spool's own stays. How many were written."""
    os.makedirs(spool_dir(), exist_ok=True)
    n = 0
    for item in items if isinstance(items, list) else []:
        name = item.get("name") if isinstance(item, dict) else None
        if not isinstance(name, str) or not SPOOL_NAME.match(name) or not isinstance(item.get("post"), dict):
            continue
        tmp = os.path.join(spool_dir(), "." + name)
        with open(tmp, "w") as f:
            json.dump(item["post"], f, ensure_ascii=False)
        os.rename(tmp, os.path.join(spool_dir(), name))
        n += 1
    return n



#!/usr/bin/env python3
"""dcctl: manage the Discord server through the REST API (standard library only).

  dcctl channels                          list categories and channels (with IDs)
  dcctl map [--me ID | --pane KEY]        the server for a Claude: categories, what each channel is for, and
                                          which one is the caller's (for altention dc read --map)
  dcctl create NAME [--category C] [--topic T] [--voice]
  dcctl ensure NAME [--category C] [--topic T]   create only if no text channel has that name
  dcctl category NAME                     create a category
  dcctl rename CHANNEL NEWNAME
  dcctl topic CHANNEL TEXT
  dcctl move CHANNEL CATEGORY             move into a category (by name or ID)
  dcctl archive CHANNEL                   move into the "archive" category (created if needed)
  dcctl delete CHANNEL --yes              only after the owner explicitly agreed in chat
  dcctl send CHANNEL TEXT                 post a message
  dcctl pin CHANNEL MESSAGE_ID [--unpin]  pin a message of that channel (--unpin: take the pin off)
  dcctl edit CHANNEL MESSAGE_ID           replace the text of a message the bot itself posted with what stdin
                                          holds; over 2000 characters is refused, never cut or split
  dcctl threads [CHANNEL]                 threads (subagents, workflows, /btw), active and archived, with IDs
  dcctl post                              (for altention dc post) a post as JSON on stdin, left for the bot to deliver
  dcctl recap CHANNEL [N]                 the last N turns (default 5) of the Claude conversation behind a channel
  dcctl history CHANNEL [N] [--chars K] [--before MESSAGE_ID]
                                          the last N messages (default 30), oldest first; each is cut to
                                          K characters (default 600, 0 = whole message)
  dcctl roles                             list roles
  dcctl guide --check                     print the guide as it would be posted (GUIDE.md expanded), touch nothing
  dcctl guide [--note TEXT]               bring the guide channel in line with GUIDE.md (its messages are edited in
                                          place); --note also posts an update notice, keeping the last 5

CHANNEL / CATEGORY may be a name (without #) or an ID; history also takes a thread's ID. Every change is also logged to #audit.
"""
import datetime
import json
import os
import re
import sys
import time
import urllib.error
import urllib.request

